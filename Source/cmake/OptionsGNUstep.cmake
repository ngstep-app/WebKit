# GNUstep compiler flags
set(CMAKE_OBJC_FLAGS "${CMAKE_OBJC_FLAGS} ${GNUSTEP_OBJC_FLAGS}")
set(CMAKE_OBJCXX_FLAGS "${CMAKE_OBJCXX_FLAGS} ${GNUSTEP_OBJC_FLAGS}")
add_definitions(-DBUILDING_GNUSTEP__=1)
add_definitions(-DGNUSTEP=1)

# Include dirs
include_directories(SYSTEM ${GNUSTEP_INCLUDE_DIRS})
link_directories(${GNUSTEP_LIBRARY_DIRS})

SET_AND_EXPOSE_TO_BUILD(USE_CURL ON)
SET_AND_EXPOSE_TO_BUILD(USE_SKIA ON)
SET_AND_EXPOSE_TO_BUILD(USE_TEXTURE_MAPPER ON)
SET_AND_EXPOSE_TO_BUILD(USE_COORDINATED_GRAPHICS ON)
SET_AND_EXPOSE_TO_BUILD(USE_GRAPHICS_LAYER_TEXTURE_MAPPER ON)
SET_AND_EXPOSE_TO_BUILD(USE_HARFBUZZ ON)
# USE_OPENSSL OFF - using GCrypt for WebCrypto, curl uses OpenSSL independently
SET_AND_EXPOSE_TO_BUILD(USE_THEME_ADWAITA ON)
SET_AND_EXPOSE_TO_BUILD(USE_XDGMIME TRUE)
SET_AND_EXPOSE_TO_BUILD(USE_GNUSTEP ON)
SET_AND_EXPOSE_TO_BUILD(USE_GLIB ON)
SET_AND_EXPOSE_TO_BUILD(USE_LCMS ON)
SET_AND_EXPOSE_TO_BUILD(USE_JPEGXL ON)
SET_AND_EXPOSE_TO_BUILD(USE_LIBEPOXY TRUE)
SET_AND_EXPOSE_TO_BUILD(USE_ANGLE ${ENABLE_WEBGL})
set(USE_ANGLE_EGL ON)
SET_AND_EXPOSE_TO_BUILD(USE_GCRYPT TRUE)
SET_AND_EXPOSE_TO_BUILD(HAVE_GL_FENCE ON)
SET_AND_EXPOSE_TO_BUILD(ENABLE_DEVELOPER_MODE ${DEVELOPER_MODE})
SET_AND_EXPOSE_TO_BUILD(USE_INSPECTOR_SOCKET_SERVER ${ENABLE_REMOTE_INSPECTOR})

# See if OpenSSL implementation is BoringSSL
cmake_push_check_state()
set(CMAKE_REQUIRED_INCLUDES "${OPENSSL_INCLUDE_DIR}")
set(CMAKE_REQUIRED_LIBRARIES "${OPENSSL_LIBRARIES}")
WEBKIT_CHECK_HAVE_SYMBOL(USE_BORINGSSL OPENSSL_IS_BORINGSSL openssl/ssl.h)
cmake_pop_check_state()

if (ENABLE_XSLT)
    find_package(LibXslt 1.1.32 REQUIRED)
endif ()

if (USE_AVIF)
    find_package(AVIF 0.9.0)
    if (NOT AVIF_FOUND)
        set(USE_AVIF OFF)
        message(STATUS "libavif not found, disabling AVIF support")
    endif ()
endif ()

if (USE_WOFF2)
    find_package(WOFF2 1.0.2 COMPONENTS dec)
    if (NOT WOFF2_FOUND)
        set(USE_WOFF2 OFF)
        message(STATUS "libwoff2 not found, disabling WOFF2")
    endif ()
    if (USE_WOFF2)
        find_package(Brotli REQUIRED COMPONENTS dec)
    endif ()
endif ()

if (USE_SKIA)
    find_package(HarfBuzz 1.4.2 REQUIRED COMPONENTS ICU)
    find_library(SHARPYUV_LIBS sharpyuv)
    SET_AND_EXPOSE_TO_BUILD(USE_HARFBUZZ ON)
endif ()

set(bmalloc_LIBRARY_TYPE OBJECT)
set(WTF_LIBRARY_TYPE OBJECT)
set(JavaScriptCore_LIBRARY_TYPE SHARED)
set(PAL_LIBRARY_TYPE OBJECT)
set(WebCore_LIBRARY_TYPE SHARED)
set(WebCoreTestSupport_LIBRARY_TYPE OBJECT)

